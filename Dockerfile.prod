# Multi-stage Dockerfile for test backend (fast, small runtime image)
# Builder: build with Maven (use same proven base as Dockerfile.prod)
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /workspace
COPY pom.xml mvnw ./
COPY .mvn .mvn
# copy sources (use wildcard for context performance)
COPY src ./src
RUN mvn -B -DskipTests package

# Runtime: reliable Temurin JRE (use focal tag which is generally available)
FROM eclipse-temurin:17-jre-focal
ARG APP_HOME=/usr/app
WORKDIR ${APP_HOME}
# copy app jar from builder
COPY --from=builder /workspace/target/*-SNAPSHOT.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java","-jar","/usr/app/app.jar"]
