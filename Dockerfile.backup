FROM debian:bookworm-slim

# Install cron, bash and MySQL client
RUN apt-get update && \
    apt-get install -y --no-install-recommends cron bash default-mysql-client ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Copy backup script and cron definition
COPY mysql_backup.sh /usr/local/bin/mysql_backup.sh
COPY backup-cron /etc/cron.d/backup-cron
RUN chmod +x /usr/local/bin/mysql_backup.sh && \
    chmod 0644 /etc/cron.d/backup-cron && \
    crontab /etc/cron.d/backup-cron

# Create backup dir and logfile for cron
RUN mkdir -p /backup /var/log && \
    touch /var/log/mysql_backup.log && \
    chmod 0644 /var/log/mysql_backup.log && \
    chown root:root /var/log/mysql_backup.log || true && \
    chown 1000:1000 /backup || true
VOLUME ["/backup"]

# Run cron in foreground
CMD ["/usr/sbin/cron", "-f"]
