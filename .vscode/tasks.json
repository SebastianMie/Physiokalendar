{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Spring Boot Application",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": ["spring-boot:run"],
      "isBackground": false,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Build Project (Maven Clean Install)",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": ["clean", "install"],
      "isBackground": false,
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
  ]
}
