# Development Environment Configuration
# Usage: docker compose -f compose.dev.yml --env-file .env.dev up -d

# Database
DB_NAME=physiocalendar_dev
DB_USER=physiouser
DB_PASSWORD=devpassword
DB_ROOT_PASSWORD=devrootpassword
DB_PORT=3306

# Backend
BACKEND_PORT=8082

# Frontend
FRONTEND_PORT=4200

# Mail (disabled in DEV, redirected to test inbox)
MAIL_ENABLED=false
MAIL_REDIRECT_ALL=true
TEST_MAIL_TO=dev-inbox@localhost

# JWT
JWT_SECRET=physiokalendarDevSecretKey2026VeryLongSecretKeyForHS256Algorithm

# Seed Data
SEED_DATA_ENABLED=true
