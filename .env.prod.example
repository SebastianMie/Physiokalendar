# Production Environment Configuration
# Usage: docker compose -f compose.prod.yml --env-file .env.prod up -d
COMPOSE_PROJECT_NAME=physio-prod
#
# IMPORTANT: Generate secure passwords and secrets before deploying!
# NEVER commit this file with real production credentials!

# Database (CHANGE THESE!)
DB_NAME=physiocalendar
DB_USER=physiouser
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_SECURE_ROOT_PASSWORD
DB_PORT=3308

# Backend
BACKEND_PORT=8080

# Frontend
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443

# Mail (configure for production)
MAIL_ENABLED=false
MAIL_REDIRECT_ALL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# JWT (CHANGE THIS!)
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_256_BIT_KEY_FOR_PRODUCTION

# Seed Data (NEVER enable in production)
SEED_DATA_ENABLED=false
