# Physiokalendar Entwicklungsumgebung
# Kopiere diese Datei nach .env und passe die Werte an

# Datenbank
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/physiocalendar
SPRING_DATASOURCE_USERNAME=physiouser
SPRING_DATASOURCE_PASSWORD=password

# Anwendung
APP_ENVIRONMENT=dev
SEED_DATA_ENABLED=false

# JWT (In Produktion einen sicheren Schlüssel verwenden!)
JWT_SECRET=physiokalendarSecretKey2026VeryLongSecretKeyForHS256Algorithm

# Mail (für Entwicklung deaktiviert)
MAIL_ENABLED=false
MAIL_REDIRECT_ALL=true
TEST_MAIL_TO=dev-inbox@localhost
