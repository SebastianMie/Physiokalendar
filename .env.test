# Test Environment Configuration
# Usage: docker compose -f compose.test.yml --env-file .env.test up -d

# Project name used by scripts and compose commands (keeps resources isolated)
COMPOSE_PROJECT_NAME=physio-test

# Database
DB_NAME=physiocalendar_test
DB_USER=physiouser
DB_PASSWORD=testpassword
DB_ROOT_PASSWORD=testrootpassword
DB_PORT=3307

# Backend
BACKEND_PORT=8081

# Frontend
FRONTEND_PORT=4201

# Mail (disabled in TEST, all mails redirected to test inbox)
MAIL_ENABLED=false
MAIL_REDIRECT_ALL=true
TEST_MAIL_TO=test-inbox@localhost

# JWT
JWT_SECRET=physiokalendarTestSecretKey2026VeryLongSecretKeyForHS256Algorithm

# Seed Data
SEED_DATA_ENABLED=true
